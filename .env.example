# Copy this file to  .env  (same folder, no other name) and put your key after LUMORA_API_KEY=
# .env is listed in .gitignore, so it is never uploaded. Never paste a key anywhere else in the project.
# Get a free Gemini key at https://aistudio.google.com/apikey
LUMORA_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
LUMORA_API_KEY=
LUMORA_API_MODEL=gemini-3.5-flash-lite
# Free tiers limit requests per minute; calls closer together than 60/RPM seconds are delayed.
LUMORA_API_RPM=20
LUMORA_API_REASONING=low
